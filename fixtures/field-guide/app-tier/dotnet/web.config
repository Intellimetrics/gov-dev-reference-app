<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="IntakeDb" connectionString="Data Source=SQL-LEG-01;Initial Catalog=IntakeDb;Integrated Security=SSPI" providerName="System.Data.SqlClient"/>
    <add name="ReportsDb" connectionString="Data Source=SQL-LEG-01;Initial Catalog=IntakeDb;User ID=rpt_reader;Password=EXAMPLE-NOT-A-REAL-PASSWORD" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation targetFramework="4.8" debug="false"/>
  </system.web>
  <system.serviceModel>
    <services>
      <service name="Agency.Intake.IntakeStatusService">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="secureBinding" contract="Agency.Intake.IIntakeStatus"/>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
      </service>
    </services>
    <client>
      <endpoint address="http://sup-ws-014.agency.example/notify" binding="basicHttpBinding" contract="Agency.Notify.INotifyService" name="notifyClient"/>
    </client>
    <bindings>
      <wsHttpBinding>
        <binding name="secureBinding"><security mode="Transport"/></binding>
      </wsHttpBinding>
    </bindings>
  </system.serviceModel>
</configuration>
